# LogiPulse Firebase Cloud Configuration
# Replace these values with your Firebase Console Project credentials
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_fcm_web_push_vapid_key_optional

# Google Maps API Configuration
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# REACT_APP_GOOGLE_MAP_KEY=""

# Note: In the absence of Firebase environment variables, LogiPulse automatically
# runs in Hackathon Local Live Mode with reactive cross-tab state and seed demo accounts!

# --- Email OTP verification (server-side only, never exposed to the browser) ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char App Password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=""
# Random string (16+ chars) used to sign OTP tokens
OTP_SECRET=
# Set to "true" only for a demo deployment without SMTP: codes are shown in the rider UI instead of emailed
OTP_DEMO_MODE=

# --- Password reset OTP (needs SMTP_* above + a Firebase service account) ---
# Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_ADMIN_CLIENT_EMAIL=
# private_key on one line, keep the \n escapes, wrap in double quotes
FIREBASE_ADMIN_PRIVATE_KEY=
