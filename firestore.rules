rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        getUserData().role == 'admin'
      );
    }

    function isRider() {
      return isAuthenticated() && (
        request.auth.token.role == 'rider' ||
        getUserData().role == 'rider'
      );
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validPriority(data) {
      return !('priority' in data) || data.priority in ['normal', 'high', 'urgent'];
    }

    // Users collection
    match /users/{userId} {
      // Authenticated users can read user profiles
      allow read: if isAuthenticated();

      // Users can create their own profile during registration (role must not be admin)
      allow create: if isOwner(userId) && request.resource.data.role != 'admin';

      // Users can update their own permitted fields, but cannot escalate to admin
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;

      // Only admins can delete or change roles
      allow delete: if isAdmin();
      allow update: if isAdmin();
    }

    // Riders collection
    match /riders/{riderId} {
      allow read: if isAuthenticated();

      // Registered rider can create and update their location, availability and delivery counter
      allow create: if isOwner(riderId);
      allow update: if isOwner(riderId) &&
        changedKeys().hasOnly(['currentLocation', 'isAvailable', 'updatedAt', 'completedDeliveries', 'city', 'warehouseId']) &&
        (!('completedDeliveries' in changedKeys()) ||
          request.resource.data.completedDeliveries == resource.data.completedDeliveries + 1);

      // When a customer completes a step with the rider's OTP, they bump that rider's job count by exactly one
      allow update: if isAuthenticated() &&
        changedKeys().hasOnly(['completedDeliveries', 'updatedAt']) &&
        request.resource.data.completedDeliveries == resource.data.get('completedDeliveries', 0) + 1;

      // Only admins can update verification status
      allow update, delete: if isAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      function claimable(data) {
        return data.status in ['pending', 'at_destination_warehouse'] && data.riderId == null;
      }
      function unchanged(field) {
        return request.resource.data.get(field, null) == resource.data.get(field, null);
      }
      function isIntercity() {
        return resource.data.get('deliveryType', 'intracity') == 'intercity';
      }
      // Next step a rider may take; OTP checks run server-side (/api/otp/verify) before the client writes
      function validRiderStep(from, to) {
        return (from == 'accepted' && to == 'picked_up') ||
          (from == 'picked_up' && to == 'in_transit') ||
          (from == 'in_transit' && to == 'delivered' && !isIntercity()) ||
          (from == 'in_transit' && to == 'at_origin_warehouse' && isIntercity()) ||
          (from == 'last_mile_accepted' && to == 'out_for_delivery') ||
          (from == 'out_for_delivery' && to == 'delivered');
      }

      // Steps a customer completes by entering the rider's OTP
      function validCustomerStep(from, to) {
        return (from == 'accepted' && to == 'picked_up') ||
          (from == 'in_transit' && to == 'delivered' && !isIntercity()) ||
          (from == 'in_transit' && to == 'at_origin_warehouse' && isIntercity()) ||
          (from == 'out_for_delivery' && to == 'delivered');
      }

      // Customers read their own orders, riders read open orders and any order they have carried, admins read all
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.riderId == request.auth.uid ||
        request.auth.uid in resource.data.get('riderIds', []) ||
        (isRider() && claimable(resource.data))
      );

      // Customers can create orders only for themselves with pending status and a valid priority
      allow create: if isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.riderId == null &&
        validPriority(request.resource.data);

      allow update: if isAuthenticated() && (
        // Admin: full control (priority escalation, warehouse dispatch / arrival)
        (isAdmin() && validPriority(request.resource.data)) ||
        // Rider claims an open order (first mile from pending, last mile from the destination warehouse)
        (
          isRider() &&
          claimable(resource.data) &&
          request.resource.data.riderId == request.auth.uid &&
          request.resource.data.status == (resource.data.status == 'pending' ? 'accepted' : 'last_mile_accepted') &&
          unchanged('priority') && unchanged('customerId') && unchanged('price') && unchanged('deliveryType')
        ) ||
        // Rider rejects an open order: only adds themselves to the rejection log
        (
          isRider() &&
          claimable(resource.data) &&
          changedKeys().hasOnly(['rejectedBy', 'rejections', 'updatedAt']) &&
          request.auth.uid in request.resource.data.rejectedBy
        ) ||
        // Assigned rider stores OTP tokens / confirmations for the current checkpoint
        (
          resource.data.riderId == request.auth.uid &&
          changedKeys().hasOnly(['verifications', 'updatedAt'])
        ) ||
        // Assigned rider advances one step. The first-mile rider releases the order at the origin warehouse.
        (
          resource.data.riderId == request.auth.uid &&
          changedKeys().hasOnly(['status', 'updatedAt', 'deliveredAt', 'statusHistory', 'verifications', 'riderId', 'currentRiderLocation']) &&
          validRiderStep(resource.data.status, request.resource.data.status) &&
          (
            request.resource.data.riderId == resource.data.riderId ||
            (request.resource.data.status == 'at_origin_warehouse' && request.resource.data.riderId == null)
          )
        ) ||
        // Assigned rider sharing live location
        (
          resource.data.riderId == request.auth.uid &&
          resource.data.status in ['accepted', 'picked_up', 'in_transit', 'last_mile_accepted', 'out_for_delivery'] &&
          changedKeys().hasOnly(['currentRiderLocation', 'riderLocationUpdatedAt'])
        ) ||
        // Customer confirms an OTP the rider read out. If it was the last code the step needed,
        // the same write completes the step (pickup, warehouse drop-off or delivery).
        (
          resource.data.customerId == request.auth.uid &&
          changedKeys().hasOnly(['verifications', 'updatedAt', 'status', 'statusHistory', 'deliveredAt', 'riderId', 'currentRiderLocation']) &&
          (
            !('status' in changedKeys()) ||
            validCustomerStep(resource.data.status, request.resource.data.status)
          ) &&
          (
            request.resource.data.riderId == resource.data.riderId ||
            (request.resource.data.status == 'at_origin_warehouse' && request.resource.data.riderId == null)
          )
        ) ||
        // Customer cancels their pending order
        (
          resource.data.customerId == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'cancelled' &&
          changedKeys().hasOnly(['status', 'updatedAt', 'statusHistory'])
        )
      );

      allow delete: if isAdmin();

      // Chat messages live under their order, so participants are checked against the parent order.
      // orderId is a path variable here, which lets Firestore authorise the realtime list query.
      match /messages/{messageId} {
        function order() {
          return get(/databases/$(database)/documents/orders/$(orderId)).data;
        }
        function isParticipant() {
          return order().customerId == request.auth.uid ||
            order().riderId == request.auth.uid ||
            request.auth.uid in order().get('riderIds', []);
        }

        allow read: if isAuthenticated() && (isAdmin() || isParticipant());

        // Posting needs an open chat: a rider holds the order and it is not cancelled or delivered.
        // Only the customer and the rider currently holding the order can post (earlier riders can read).
        function chatOpen() {
          return order().riderId != null && !(order().status in ['cancelled', 'delivered']);
        }
        function canPost() {
          return order().customerId == request.auth.uid || order().riderId == request.auth.uid;
        }

        allow create: if isAuthenticated() &&
          chatOpen() &&
          (isAdmin() || canPost()) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.orderId == orderId &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000;

        allow update, delete: if isAdmin();
      }
    }

    // Notifications collection
    // userId is either a user's uid or a shared inbox: 'admin', 'riders' or 'all'
    match /notifications/{notificationId} {
      function canReadInbox(inbox) {
        return inbox == request.auth.uid ||
          inbox == 'all' ||
          (inbox == 'riders' && isRider()) ||
          // Per-city rider inbox, e.g. 'riders-wh-karachi'
          (inbox.matches('riders-.*') && isRider()) ||
          isAdmin();
      }

      allow read: if isAuthenticated() && canReadInbox(resource.data.userId);

      // Any signed-in user can trigger a notification (order events, chat messages)
      allow create: if isAuthenticated() &&
        request.resource.data.isRead == false &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 200;

      // Recipient can mark notification as read
      allow update: if isAuthenticated() &&
        canReadInbox(resource.data.userId) &&
        changedKeys().hasOnly(['isRead']);

      allow delete: if isAdmin();
    }
  }
}
